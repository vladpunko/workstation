#!/usr/bin/env sh

# Created by: Vladislav Punko <iam.vlad.punko@gmail.com>
# Created date: 2023-06-25

set -o errexit
set -o nounset

_require_command() {
  # Fail fast with a dedicated message when a required external program is
  # missing from the machine.
  if command -v "$1" > /dev/null 2>&1; then
    _print_success "$2"
  else
    _print_error "$3"
    _print_warning "$4"
    exit 1
  fi
}

_print_error() {
  # `printf` understands `\033` in the format string, so the color escapes stay
  # readable without relying on `echo`-specific flags.
  printf "[\\033[31;1mERROR\\033[0m]: %s\\n" "$1" >&2
}

_print_success() {
  printf "[\\033[32;1mOK\\033[0m]: %s\\n" "$1"
}

_print_warning() {
  printf "[\\033[33;1mWARNING\\033[0m]: %s\\n" "$1"
}

_require_command \
  git \
  'Git is installed.' \
  'Git does not seem to be installed.' \
  'Install git via your package manager or directly from https://git-scm.com/.'

_require_command \
  git-lfs \
  'Git large file storage is detected and ready to use.' \
  'Git large file storage is missing or not properly installed.' \
  'It can be installed through your package manager or by visiting https://git-lfs.com/.'

# Require exactly the source and destination repository URLs.
if [ "$#" -ne 2 ]; then
  _print_error "You are to use: $(command basename -- "$0") <source: URL> <destination: URL>"
  # Stop immediately when the invocation is incomplete.
  exit 2
fi

# Work in a temporary bare repository so the mirror operation does not touch
# the caller's current directory.
workdir="$(command mktemp -d)"

_cleanup() {
  command rm -f -r -- "${workdir}"
}

# Always remove the temporary bare repository, even if `git fetch` or
# `git push --mirror` fails.
trap _cleanup 0 1 2 3 6

src_url="$1"
dst_url="$2"

# Ask for confirmation before mirroring every ref and LFS object.
printf "[\\033[33;1mWARNING\\033[0m]: Do you want to mirror this repository? [Y/n]: "
read -r answer

case "${answer:-Y}" in
  [Yy]*)
    # Follow the approved path: fetch every ref and every LFS object, then push
    # the full mirror to the destination repository.
    _print_warning "Fetching from ${src_url} into ${dst_url}..."

    # Create a bare working area under the temporary directory.
    cd -- "${workdir}" && command git init --bare -- "${workdir}"

    # Point `origin` at the source repository that will be mirrored.
    command git config remote.origin.url "${src_url}"

    command git config --add remote.origin.fetch '+refs/heads/*:refs/heads/*'
    command git config --add remote.origin.fetch '+refs/notes/*:refs/notes/*'
    command git config --add remote.origin.fetch '+refs/tags/*:refs/tags/*'

    # Mark the temporary repository as a mirror so `git push --mirror` exports
    # every tracked ref.
    command git config remote.origin.mirror true

    # Download every configured ref from the source repository.
    command git fetch --all

    # Pull every Git LFS object referenced by the mirrored refs.
    # See information: https://github.com/git-lfs/git-lfs/issues/1338
    command git-lfs fetch --all

    _print_warning "All components were saved in ${workdir}. Pushing into ${dst_url}..."

    # Push both regular Git refs and Git LFS objects to the destination.
    command git push --mirror -- "${dst_url}"
    command git-lfs push --all -- "${dst_url}"

    _print_success 'Done!'
    ;;
  *)
    # Exit quietly on the explicit cancel path without touching either
    # repository.
    _print_error 'Cancelled.'
    exit 1
    ;;
esac
