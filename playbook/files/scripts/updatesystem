#!/bin/bash

# Created by: Vladislav Punko <iam.vlad.punko@gmail.com>
# Created date: 2021-08-12

set -o errexit
set -o nounset

# Optional updates are independent, but any failure must reach the caller.
update_status=0

# Keep administrator privileges limited to system updates.
if [[ "${EUID}" -eq 0 ]]
then
  # Refresh package metadata and install available updates.
  command dnf upgrade --refresh --assumeyes

  # Clear the package cache.
  command dnf clean all

  if [[ -x "$(command -v freshclam)" ]]
  then
    command freshclam --show-progress || update_status=1
  fi

  exit "${update_status}"
fi

# Ask for privileges once for all system updates.
command sudo -- /bin/bash "$0" || update_status=$?

# Do not start user updates after an interrupted system update.
if [[ "${update_status}" -ge 128 ]]
then
  exit "${update_status}"
fi

# An activated project environment must not become the update target.
if [[ -x "${HOME}/.miniconda/bin/conda" ]]
then
  command "${HOME}/.miniconda/bin/conda" update --name base --all --yes || update_status=1
fi

exit "${update_status}"
