#!/bin/bash

# Created by: Vladislav Punko <iam.vlad.punko@gmail.com>
# Created date: 2023-06-25

set -o errexit
set -o nounset

# Fail early with a clear message when `brew` is not installed.
if [[ ! -x "$(command -v brew)" ]]
then
  echo 'Homebrew is not installed.' >&2
  # Stop this program runtime and return the exit status code.
  exit 1
fi

# Package upgrades depend on fresh Homebrew metadata.
command brew update

# Separate upgrade steps make failures easier to identify.
command brew upgrade --formula
command brew upgrade --cask

# Removing cached downloads alone leaves old package versions installed.
command brew cleanup

# Remove all contents from the homebrew cache directory.
homebrew_cache="$(command brew --cache)"
command rm -f -r -- "${homebrew_cache}"

# Optional updates are independent, but any failure must reach the caller.
update_status=0

if [[ -x "$(command -v freshclam)" ]]
then
  command freshclam --show-progress || update_status=1
fi

# An activated project environment must not become the update target.
if [[ -x "${HOME}/.miniconda/bin/conda" ]]
then
  command "${HOME}/.miniconda/bin/conda" update --name base --all --yes || update_status=1
fi

exit "${update_status}"
