[system/locale]
# Set the main encoding for the current operating system.
region='en_US.UTF-8'

[org/gnome/shell]
# Use this extension to show icons in the tray bar.
# See information: https://github.com/ubuntu/gnome-shell-extension-appindicator
enabled-extensions=['appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Ptyxis.desktop', 'chromium-browser.desktop', 'net.thunderbird.Thunderbird.desktop', 'code.desktop', 'org.gnome.TextEditor.desktop']
last-selected-power-profile='performance'

[org/gnome/settings-daemon/plugins/power]
idle-dim=false
sleep-inactive-ac-timeout=7200
sleep-inactive-battery-timeout=1800

[org/gtk/gtk4/settings/file-chooser]
show-hidden=true
sort-directories-first=true

[org/gnome/desktop/interface]
show-battery-percentage=true

[org/gnome/desktop/privacy]
remember-recent-files=false
report-technical-problems=false

[org/gnome/desktop/datetime]
automatic-timezone=false

[org/gnome/desktop/input-sources]
xkb-options=@as []
per-window=true
current=uint32 0
mru-sources=[('xkb', 'us'), ('xkb', 'ru')]
sources=[('xkb', 'us'), ('xkb', 'ru')]

[org/gnome/system/location]
enabled=false

[org/gnome/desktop/notifications]
show-in-lock-screen=false

[org/gnome/desktop/media-handling]
autorun-never=true

[org/gnome/Ptyxis]
audible-bell=false
default-profile-uuid='4bf9765b7b28053097d88b8c68ae069b'
profile-uuids=['4bf9765b7b28053097d88b8c68ae069b']
restore-session=false
restore-window-size=false
scrollbar-policy='never'
visual-bell=false
window-size=(uint32 200, uint32 50)

[org/gnome/Ptyxis/Profiles/4bf9765b7b28053097d88b8c68ae069b]
limit-scrollback=false
login-shell=false
palette='Dark Pastel'

[org/gnome/Ptyxis/Shortcuts]
primary-menu=''
