[Unit]
Description=Jupyter Notebook server

[Service]
# Start this service as a separate process on the current operating system.
Type=simple

# Start the main jupyter notebook server on the current operating system.
ExecStart=%h/.miniconda/bin/jupyter-notebook

# Restart the main process after a failure.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
