if [[ -f /etc/zshrc ]]; then
  # Load the main settings of the current operating system.
  source /etc/zshrc
fi

# Set a restrictive umask to ensure maximum security for data.
umask 077

source "${HOME}/.config/zsh/aliases.zsh"
source "${HOME}/.config/zsh/completions.zsh"
source "${HOME}/.config/zsh/exports.zsh"
source "${HOME}/.config/zsh/functions.zsh"

# Save each command's beginning timestamp and the duration to the history file.
setopt extended_history

# Retain unique commands in history by removing older duplicates first when history reaches its size limit.
setopt hist_expire_dups_first

# Do not enter command lines into the history list if they are duplicates of the previous event.
setopt hist_ignore_dups

# Ignore commands that start with space.
setopt hist_ignore_space

# Show command with history expansion to user before running it.
setopt hist_verify

# Share command history data.
setopt share_history

# Use emacs key bindings.
bindkey -e

# Delete the character behind the cursor.
bindkey '^?' backward-delete-char

# Delete the character in front of the cursor.
bindkey '^[[3~' delete-char

bindkey '^[3;5~' delete-char

# Expand history references before inserting a space.
bindkey ' ' magic-space

# Edit the current command line in the main text editor.
autoload -U edit-command-line
zle -N edit-command-line
bindkey '\C-x\C-e' edit-command-line

# Load the Miniconda shell hooks when `~/.miniconda` is installed.
if [[ -f "${HOME}/.miniconda/etc/profile.d/conda.sh" ]]; then
  source "${HOME}/.miniconda/etc/profile.d/conda.sh"
fi

# Initialize the `pyenv` shims without defining the shell helper function, so
# the existing `pyenv` alias keeps working as before.
if whence -p pyenv > /dev/null 2>&1; then
  eval -- "$(command pyenv init --path)" 2> /dev/null
fi

# Load `virtualenvwrapper.sh` only when it is installed.
if command -v virtualenvwrapper.sh > /dev/null 2>&1; then
  source -- "$(command -v virtualenvwrapper.sh)"
fi

# Load the `fzf` key bindings and completion hooks when available.
if command -v fzf > /dev/null 2>&1; then
  eval -- "$(command fzf --zsh)"
fi

# Enable `zoxide` when it is installed.
if command -v zoxide > /dev/null 2>&1; then
  eval -- "$(command zoxide init zsh)"
fi
