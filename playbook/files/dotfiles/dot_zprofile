export PYENV_ROOT="${HOME}/.pyenv"

# Build `PATH` from user tools plus both Homebrew prefixes so the same file
# works on Apple Silicon and Intel Macs.
typeset -U path
path=(
  "${PYENV_ROOT}/bin"
  "${HOME}/.miniconda/bin"
  "${HOME}/bin"
  "${HOME}/.local/bin"
  /opt/homebrew/bin
  /opt/homebrew/sbin
  /usr/local/bin
  /usr/local/sbin
  $path
)
